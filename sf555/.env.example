# Skopiuj ten plik jako `.env` i uzupelnij wlasnymi danymi.
# `.env` jest zablokowany w .gitignore i NIGDY nie trafia do repozytorium.

# Adres bazy. Przy Dockerze: nazwa uslugi (db).
# Na zwyklym hostingu prawie zawsze: localhost
SF_DB_HOST=localhost
SF_DB_PORT=3306
SF_DB_NAME=sf555

# Konto aplikacyjne o ograniczonych uprawnieniach — NIE root.
# Utworzysz je skryptem deploy/db_user.sql
SF_DB_USER=sf555_app
SF_DB_PASS=tutaj-dlugie-losowe-haslo
