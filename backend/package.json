{
  "name": "lorein-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend gry Lorein w TypeScript — stopniowy port req.php",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/prepare-static.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "test:db": "vitest run",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "gen:gamedata": "node scripts/gen-gamedata.mjs",
    "gen:chardata": "node scripts/gen-chardata.mjs",
    "prepare:static": "node scripts/prepare-static.mjs",
    "vercel-build": "node scripts/prepare-static.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
