# Skopiuj jako `.env` (plik jest w .gitignore).

PORT=8787

# --- Baza: Supabase ---
# Supabase > Project Settings > Database > Connection string
#
# Na Vercelu uzyj poolera w trybie transakcyjnym (port 6543):
#   postgresql://postgres.PROJEKT:HASLO@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Na VPS-ie mozesz uzyc polaczenia bezposredniego (port 5432):
#   postgresql://postgres:HASLO@db.PROJEKT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:haslo@localhost:5432/lorein

# --- Stary backend PHP (opcjonalnie) ---
# Akcje jeszcze nieprzeniesione sa tam przekazywane. Ma to sens WYLACZNIE
# wtedy, gdy PHP pracuje na tej samej bazie co nowy backend.
# Zostaw puste, zeby wylaczyc przekazywanie.
SF_LEGACY_URL=

# Panel testowy u grzybiarza (awans, zloto, grzyby, reset piw i poziomu).
# Dopoki gra jest w budowie, stoi WLACZONY — to cheaty, wiec przed
# wpuszczeniem obcych graczy ustaw tu zero.
LOREIN_PANEL_TESTOWY=1
